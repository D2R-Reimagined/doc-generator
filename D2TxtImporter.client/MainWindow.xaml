<Window x:Class="D2TxtImporter.client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="D2TxtImporter" Height="450" Width="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="15px">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <!-- Spacer row below browse fields -->
            <RowDefinition Height="auto"/>
            <!-- Settings group -->
            <RowDefinition Height="auto"/>
            <!-- Exports group -->
            <RowDefinition Height="auto"/>
            <!-- Bottom buttons -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110px"/>
                <ColumnDefinition />
                <ColumnDefinition Width="100px"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0">Excel Directory</Label>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ExcelPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            <Button Grid.Row="0" Grid.Column="2" Click="BrowseExcel">Browse</Button>

            <Label Grid.Row="1" Grid.Column="0">JSON Directory</Label>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TablePath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            <Button Grid.Row="1" Grid.Column="2" Click="BrowseTable">Browse</Button>

            <Label Grid.Row="2" Grid.Column="0">Output Directory</Label>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            <Button Grid.Row="2" Grid.Column="2" Click="BrowseOutput">Browse</Button>
        </Grid>

        <GroupBox Grid.Row="2" Header="Settings">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <CheckBox Grid.Row="0" IsChecked="{Binding ContinueOnException}">Continue on Exception</CheckBox>
                <CheckBox Grid.Row="1" IsChecked="{Binding CubeRecipeUseDescription}">Use Cube Recipe Description</CheckBox>
            </Grid>
        </GroupBox>

        <!-- Separate Exports group placed on its own grid row -->
        <GroupBox Grid.Row="3" Header="Exports">
            <StackPanel Margin="10" Orientation="Vertical">
                <CheckBox Margin="0,0,0,0" IsChecked="{Binding ExportWeb}">Export Web (Legacy)</CheckBox>
                <CheckBox Margin="0,6,0,0" IsChecked="{Binding ExportJson}">Export JSONs</CheckBox>
                <CheckBox Margin="16,6,0,0" IsChecked="{Binding PrettyPrintJson}" IsEnabled="{Binding ExportJson}">VSC JSON Indents</CheckBox>
                <!-- Reports moved here between JSONs and Web (not nested under JSONs) -->
                <CheckBox Margin="16,6,0,0" IsChecked="{Binding DuplicateKeyReportEnabled}" IsEnabled="{Binding ExportJson}">JSON Key Dupe (TSV)</CheckBox>
                <CheckBox Margin="0,6,0,0" IsChecked="{Binding RequiredLevelReportEnabled}">Req Lvl Mismatch (TSV)</CheckBox>
                <CheckBox Margin="0,6,0,0" IsChecked="{Binding ItemStatCostExportEnabled}">itemstatcost.txt Ranges (TSV)</CheckBox>
                <CheckBox Margin="0,6,0,0" IsChecked="{Binding ExportExcel}">Excel (D2RR_Holy_Grail.xlsx)</CheckBox>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="4" Height="24px" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Padding="10 0 10 0" Margin="10 0 10 0" Click="LoadData" IsEnabled="{Binding ImportEnabled, UpdateSourceTrigger=PropertyChanged}">Import and Export</Button>
            <!-- <Button Grid.Column="1" Margin="2 0 0 0" Click="ExportData" IsEnabled="{Binding ExportEnabled, UpdateSourceTrigger=PropertyChanged}">Export</Button> -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <ProgressBar Width="150" Height="14" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding StatusText}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
