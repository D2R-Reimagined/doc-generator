<Window x:Class="D2TxtImporter.client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="D2TxtImporter" Height="600" Width="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="15px">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <!-- Spacer row below browse fields -->
            <RowDefinition Height="auto"/>
            <!-- Settings group -->
            <RowDefinition Height="auto"/>
            <!-- Exports group -->
            <RowDefinition Height="auto"/>
            <!-- Bottom buttons -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110px"/>
                <ColumnDefinition />
                <ColumnDefinition Width="100px"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0">Excel Directory</Label>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ExcelPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            <Button Grid.Row="0" Grid.Column="2" Click="BrowseExcel">Browse</Button>

            <Label Grid.Row="1" Grid.Column="0">JSON Directory</Label>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TablePath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            <Button Grid.Row="1" Grid.Column="2" Click="BrowseTable">Browse</Button>

            <Label Grid.Row="2" Grid.Column="0">Output Directory</Label>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            <Button Grid.Row="2" Grid.Column="2" Click="BrowseOutput">Browse</Button>
        </Grid>

        <GroupBox Grid.Row="2" Header="Settings">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <CheckBox Grid.Row="0" IsChecked="{Binding ContinueOnException}">Continue on Exception</CheckBox>
            </Grid>
        </GroupBox>

        <!-- Separate Exports group placed on its own grid row -->
        <GroupBox Grid.Row="3" Header="Exports">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column: JSON exports -->
                <GroupBox Grid.Column="0" Header="JSON exports" Margin="0,0,10,0">
                    <StackPanel Orientation="Vertical" Margin="10,6,10,10">
                        <CheckBox Margin="0,0,0,0" IsChecked="{Binding ExportJson}" ToolTip="Master switch for JSON files (uniques, sets, runewords, weapons, armors, magic affixes).">Export JSONs</CheckBox>
                        <CheckBox Margin="16,2,0,0" IsChecked="{Binding PrettyPrintJson}" IsEnabled="{Binding ExportJson}" ToolTip="Indents all JSON exports, including Cube Recipes V2.">VSC Indents</CheckBox>
                        <CheckBox Margin="16,2,0,0" IsChecked="{Binding DuplicateKeyReportEnabled}" IsEnabled="{Binding ExportJson}" ToolTip="Writes 'jason key duplicates.txt' under json/. Scans translation keys in tbl/json (independent of which JSON files you export).">Report Key Dupes (TSV)</CheckBox>
                        <CheckBox Margin="16,2,0,0" IsChecked="{Binding ExportSetsByBase}" IsEnabled="{Binding ExportJson}" ToolTip="Writes sets_by_base.json grouping set items under each base armor/weapon.">Sets grouped by base (sets_by_base.json)</CheckBox>

                        <CheckBox Margin="0,10,0,0" IsChecked="{Binding CubeRecipesV2ExportEnabled}" ToolTip="Enable export of cuberecipesv2.json">Cube Recipes V2</CheckBox>
                        <CheckBox Margin="16,2,0,0"
                                  IsChecked="{Binding EarlyStopSentinelEnabled}" IsEnabled="{Binding CubeRecipesV2ExportEnabled}"
                                  ToolTip="When enabled, stop at the grabber recipes which are the last useful recipe before the stacking recipes.">
                            Ignore Beyond Grabbers
                        </CheckBox>
                        <CheckBox Margin="16,2,0,0"
                                  IsChecked="{Binding CubeRecipeUseDescription}" IsEnabled="{Binding CubeRecipesV2ExportEnabled}"
                                  ToolTip="Include the raw cubeMain.txt 'description' field in cuberecipesv2.json for each recipe">
                            Include cubemain.txt Description
                        </CheckBox>
                    </StackPanel>
                </GroupBox>

                <!-- Right column: Other outputs & reports (non-JSON) -->
                <GroupBox Grid.Column="1" Header="Other outputs &amp; reports" Margin="10,0,0,0">
                    <StackPanel Orientation="Vertical" Margin="10,6,10,10">
                        <CheckBox Margin="0,0,0,0" IsChecked="{Binding ExportWeb}" ToolTip="Legacy HTML bundle.">Export Web (Legacy)</CheckBox>
                        <CheckBox Margin="0,6,0,0" IsChecked="{Binding ExportExcel}" ToolTip="Exports Excel workbook (D2RR_Holy_Grail.xlsx)">Excel (D2RR_Holy_Grail.xlsx)</CheckBox>
                        <CheckBox Margin="0,6,0,0" IsChecked="{Binding RequiredLevelReportEnabled}" ToolTip="Writes 'required level properties.txt' under json/ to analyze required level mismatches.">Req Lvl Mismatch (TSV)</CheckBox>
                        <CheckBox Margin="0,6,0,0" IsChecked="{Binding ItemStatCostExportEnabled}" ToolTip="Writes 'item stat ranges.txt' under json/ (TSV) with min/max ranges and param bits.">itemstatcost.txt Ranges (TSV)</CheckBox>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="4" Height="24px" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Padding="10 0 10 0" Margin="10 0 10 0" Click="LoadData" IsEnabled="{Binding ImportEnabled, UpdateSourceTrigger=PropertyChanged}">Import and Export</Button>
            </StackPanel>
            <!-- <Button Grid.Column="1" Margin="2 0 0 0" Click="ExportData" IsEnabled="{Binding ExportEnabled, UpdateSourceTrigger=PropertyChanged}">Export</Button> -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                <ProgressBar Width="150" Height="14" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding StatusText}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <Button Padding="10 0 10 0" Margin="10 0 10 0" Click="OpenPatchDiff">JSON Compare</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
