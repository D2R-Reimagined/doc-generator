<Window x:Class="D2TxtImporter.client.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" MinWidth="360">
    <Border Padding="16" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       MaxWidth="540"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="OkButton" Width="90" Margin="4,0" IsDefault="True" Click="Ok_Click">OK</Button>
                <Button x:Name="CancelButton" Width="90" Margin="4,0" IsCancel="True" Click="Cancel_Click">Cancel</Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
